# MySQL 8 (Railway public TCP proxy URL)
DATABASE_URL=mysql://user:password@host:port/railway
# Separate database used by integration tests (truncated between runs)
TEST_DATABASE_URL=mysql://user:password@host:port/shiftline_test
# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs the demo role cookie (manager / worker)
SESSION_SECRET=
# 1 enables ?latency= and ?fail= on API routes for the demo states menu
DEMO_FLAGS=1
